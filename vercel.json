{
  "headers": [
    {
      "source": "/static/(.*)\\.(js|css|webp|woff2|woff|eot|ttf|otf|svg)$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}